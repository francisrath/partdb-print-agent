[Unit]
Description=pdb-print label print agent for Part-DB
Documentation=https://github.com/francisrath/pdb-print
After=network-online.target
Wants=network-online.target

[Service]
User=pdb-print
Group=pdb-print
# lp: USB printers (/dev/usb/lp*); bluetooth: Bluetooth LE printers via BlueZ; dialout: serial ports (/dev/tty*)
SupplementaryGroups=lp bluetooth dialout
# /var/lib/pdb-print (config) and /var/cache/pdb-print (PDFium compile cache)
StateDirectory=pdb-print
StateDirectoryMode=0700
CacheDirectory=pdb-print
Environment=XDG_CACHE_HOME=/var/cache
# --setup-window: until Part-DB is connected, the setup wizard is open to the LAN for a while
ExecStart=/usr/bin/pdb-print --config /var/lib/pdb-print/config.yaml serve --setup-window
Restart=on-failure
# on stop, a label being printed finishes (serve waits up to 2 minutes)
TimeoutStopSec=130
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
