# pdb-print environment. Copy to .env (gitignored), fill in, then load it into your shell:
#   set -a; . ./.env; set +a
# The binary never reads this file itself.

# Part-DB base URL (no /api)
PDB_PRINT_URL=https://partdb.example.org
# Read-Only API token: Part-DB → your username (top right) → User settings → API tokens
PDB_PRINT_TOKEN=
# Printer config (YAML); copy config.example.yaml to config.local.yaml (gitignored) to customise
PDB_PRINT_CONFIG=config.example.yaml
